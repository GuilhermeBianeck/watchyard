# EXAMPLE ONLY. Copy to runtime.env on the future VPS, then replace VPN values.
# Apply with: docker compose --env-file runtime.env -f compose.yaml ...
WATCHYARD_BIND_IP=100.101.102.103
WATCHYARD_DATA_DIR=./data
WATCHYARD_DEPLOYMENT=vps
WATCHYARD_DATA=/data
WATCHYARD_MODEL_BACKEND=pytorch
WATCHYARD_MODEL_DEVICE=cpu
WATCHYARD_DECODER=software
WATCHYARD_HOST=0.0.0.0
WATCHYARD_PORT=8765
WATCHYARD_LOCAL_BYPASS=0
